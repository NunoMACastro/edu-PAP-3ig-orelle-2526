{
    "name": "orelle-web",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": "24.11.1"
    },
    "scripts": {
        "dev": "vite --host 127.0.0.1",
        "build": "vite build",
        "lint": "eslint src tests scripts vite.config.js vitest.config.js playwright.config.js",
        "test": "npm run test:unit && npm run test:contracts",
        "test:unit": "vitest run",
        "test:contracts": "node --test tests/*.test.mjs",
        "test:e2e": "playwright test",
        "images:brand": "node scripts/generate-brand-assets.mjs",
        "images:editorial": "node scripts/generate-editorial-images.mjs",
        "images:generate": "node scripts/generate-responsive-product-images.mjs",
        "check:g6-image-budgets": "node scripts/check-responsive-image-budgets.mjs",
        "check:g1-config": "node scripts/check-g1-runtime-config.mjs",
        "test:g1-dev-proxy": "node scripts/check-g1-dev-proxy.mjs",
        "test:g1-api-client": "node --test tests/apiClient.test.mjs",
        "preview": "vite preview",
        "test:g2-checkout": "node --test tests/simulatedCheckout.test.mjs",
        "test:g4-guided": "node --test tests/guidedRecommendation.test.mjs",
        "test:g4-provider-consent": "node --test tests/providerConsent.test.mjs",
        "smoke:g2-checkout": "node scripts/check-g2-simulated-checkout.mjs",
        "smoke:mf2": "node scripts/smoke-mf2-recommendations.mjs",
        "smoke:mf5-privacy-request": "node scripts/check-mf5-biometric-request-client.mjs",
        "smoke:mf5-feedback": "node scripts/check-mf5-feedback.mjs",
        "smoke:mf5-theme": "node scripts/check-mf5-theme.mjs",
        "smoke:mf6-images": "node scripts/check-mf6-images.mjs",
        "smoke:mf6-performance-unit": "node scripts/check-mf6-performance-unit.mjs",
        "smoke:mf6-page-budget": "node scripts/check-mf6-page-budget.mjs",
        "smoke:mf6-runtime": "node scripts/check-mf6-runtime-performance.mjs",
        "smoke:mf7-compat": "node scripts/check-mf7-browser-compatibility.mjs",
        "smoke:mf8-consultation": "node scripts/check-mf8-guided-consultation-page.mjs",
        "smoke:mf8-ai-history": "node scripts/check-mf8-ai-history-page.mjs",
        "smoke:mf8-assisted-consultation": "node scripts/check-mf8-assisted-consultation-ui.mjs"
    },
    "dependencies": {
        "@mediapipe/tasks-vision": "0.10.35",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^6.30.4"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.12.1",
        "@eslint/js": "10.0.1",
        "@playwright/test": "1.61.1",
        "@testing-library/dom": "10.4.1",
        "@testing-library/jest-dom": "6.9.1",
        "@testing-library/react": "16.3.2",
        "@testing-library/user-event": "14.6.1",
        "@vitejs/plugin-react": "6.0.3",
        "eslint": "10.6.0",
        "eslint-plugin-react-hooks": "7.1.1",
        "eslint-plugin-react-refresh": "0.5.3",
        "globals": "17.7.0",
        "jsdom": "29.1.1",
        "sharp": "0.35.3",
        "vite": "8.1.4",
        "vitest": "4.1.10"
    }
}
